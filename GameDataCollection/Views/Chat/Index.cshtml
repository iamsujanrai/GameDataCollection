@model List<GameDataCollection.Models.ChatMessage>
@{
    ViewData["Title"] = "Messages";
    Layout = null;          // Standalone — no sidebar
    string userId  = ViewBag.UserId;
    string adminId = ViewBag.AdminId;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#007bff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Support Chat" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/dist/img/AdminLTELogo.png" />
    <title>Messages</title>
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: #e5ddd5;
            height: 100dvh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* ── Header ── */
        .chat-header {
            background: #007bff;
            color: #fff;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
            flex-shrink: 0;
            padding-top: max(10px, env(safe-area-inset-top));
        }
        .chat-header .back-btn {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            display: flex;
            align-items: center;
        }
        .avatar {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,.3);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .chat-header .info { flex: 1; }
        .chat-header .info h2 { font-size: 16px; font-weight: 600; }
        .chat-header .info small { font-size: 12px; opacity: .85; }

        /* Install button (shown when PWA is installable) */
        #install-btn {
            display: none;
            background: rgba(255,255,255,.2);
            border: 1px solid rgba(255,255,255,.5);
            color: #fff;
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 12px;
            cursor: pointer;
            white-space: nowrap;
        }

        /* ── Messages area ── */
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 12px 10px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .msg-row {
            display: flex;
            margin-bottom: 2px;
        }
        .msg-row.mine  { justify-content: flex-end; }
        .msg-row.theirs { justify-content: flex-start; }

        .bubble {
            max-width: 72%;
            padding: 8px 12px;
            border-radius: 18px;
            font-size: 14px;
            line-height: 1.45;
            word-break: break-word;
            position: relative;
        }
        .mine  .bubble {
            background: #dcf8c6;
            border-bottom-right-radius: 4px;
            color: #111;
        }
        .theirs .bubble {
            background: #fff;
            border-bottom-left-radius: 4px;
            color: #111;
            box-shadow: 0 1px 2px rgba(0,0,0,.12);
        }
        .bubble img {
            max-width: 220px; max-height: 220px;
            border-radius: 10px; display: block;
            cursor: pointer;
        }
        .bubble .ts {
            font-size: 11px;
            color: #888;
            text-align: right;
            margin-top: 3px;
        }

        /* Date divider */
        .date-divider {
            text-align: center;
            margin: 10px 0 6px;
        }
        .date-divider span {
            background: rgba(0,0,0,.15);
            color: #555;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 10px;
        }

        /* ── Input bar ── */
        .chat-input-bar {
            background: #f0f0f0;
            padding: 8px 10px;
            display: flex;
            align-items: flex-end;
            gap: 8px;
            flex-shrink: 0;
            padding-bottom: max(8px, env(safe-area-inset-bottom));
        }
        #image-preview-wrap {
            display: none;
            padding: 6px 10px;
            background: #f0f0f0;
            border-top: 1px solid #ddd;
            flex-shrink: 0;
        }
        #image-preview-wrap img { max-height: 70px; border-radius: 8px; }
        #image-preview-wrap .cancel-img {
            background: #dc3545; color: #fff;
            border: none; border-radius: 50%;
            width: 22px; height: 22px;
            font-size: 12px; cursor: pointer;
            vertical-align: top; margin-left: 6px;
        }

        .attach-btn, .send-btn {
            background: none; border: none;
            color: #555; font-size: 22px;
            cursor: pointer; padding: 4px;
            flex-shrink: 0; line-height: 1;
        }
        .send-btn { color: #007bff; }
        .send-btn:disabled { color: #aaa; }

        #msg-input {
            flex: 1;
            border: none;
            border-radius: 22px;
            padding: 9px 14px;
            font-size: 15px;
            background: #fff;
            outline: none;
            resize: none;
            max-height: 120px;
            min-height: 40px;
            line-height: 1.4;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);
        }

        /* Lightbox */
        #lightbox {
            display: none; position: fixed; inset: 0;
            background: rgba(0,0,0,.9); z-index: 9999;
            align-items: center; justify-content: center;
        }
        #lightbox.open { display: flex; }
        #lightbox img { max-width: 95vw; max-height: 90vh; border-radius: 6px; }
        #lightbox .close-lb {
            position: absolute; top: 14px; right: 18px;
            color: #fff; font-size: 28px; cursor: pointer;
        }

        /* Typing indicator */
        .typing-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #aaa; margin: 0 2px; animation: bounce .9s infinite; }
        .typing-dot:nth-child(2) { animation-delay: .2s; }
        .typing-dot:nth-child(3) { animation-delay: .4s; }
        @@keyframes bounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-6px)} }
    </style>
</head>
<body>

<!-- Lightbox -->
<div id="lightbox"><span class="close-lb">&times;</span><img id="lb-img" /></div>

<!-- Header -->
<div class="chat-header">
    <a href="/UserDashboard/Index" class="back-btn" title="Back to Dashboard">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div class="avatar"><i class="fas fa-headset"></i></div>
    <div class="info">
        <h2>Support</h2>
        <small>We typically reply within minutes</small>
    </div>
    <button id="install-btn" title="Install app"><i class="fas fa-download"></i> Install</button>
</div>

<!-- Image preview (above input) -->
<div id="image-preview-wrap">
    <img id="image-preview" src="" alt="preview" />
    <button class="cancel-img" id="cancel-image">&times;</button>
</div>

<!-- Messages -->
<div class="chat-messages" id="chat-box">
    @{
        DateTime? lastDate = null;
    }
    @foreach (var msg in Model)
    {
        var msgDate = msg.SentAt.ToLocalTime().Date;
        if (lastDate == null || lastDate != msgDate)
        {
            var label = msgDate == DateTime.Today ? "Today"
                      : msgDate == DateTime.Today.AddDays(-1) ? "Yesterday"
                      : msgDate.ToString("MMM dd, yyyy");
            <div class="date-divider"><span>@label</span></div>
            lastDate = msgDate;
        }
        bool isMine = msg.SenderId == userId;
        <div class="msg-row @(isMine ? "mine" : "theirs")">
            <div class="bubble">
                @if (!string.IsNullOrEmpty(msg.ImagePath))
                {
                    <img src="@msg.ImagePath" data-src="@msg.ImagePath" class="chat-img" />
                }
                @if (!string.IsNullOrEmpty(msg.Message))
                {
                    <div>@msg.Message</div>
                }
                <div class="ts">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</div>
            </div>
        </div>
    }
    <div id="chat-end"></div>
</div>

<!-- Input bar -->
<div class="chat-input-bar">
    <label class="attach-btn" title="Send image">
        <i class="fas fa-paperclip"></i>
        <input type="file" id="img-file" accept="image/*" style="display:none" />
    </label>
    <textarea id="msg-input" placeholder="Type a message..." rows="1"></textarea>
    <button class="send-btn" id="send-btn" disabled>
        <i class="fas fa-paper-plane"></i>
    </button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
(function () {
    const myUserId = "@userId";
    const adminId  = "@adminId";
    let pendingImagePath = null;

    // ── SignalR ───────────────────────────────────────────────────────────
    const conn = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

    conn.on("ReceiveMessage", function (msg) {
        appendMessage(msg);
        scrollToBottom();
        if (msg.senderId !== myUserId) conn.invoke("MarkRead", msg.senderId).catch(() => {});
    });

    conn.start().then(() => conn.invoke("MarkRead", adminId).catch(() => {})).catch(console.error);

    // ── Send ──────────────────────────────────────────────────────────────
    const input    = document.getElementById("msg-input");
    const sendBtn  = document.getElementById("send-btn");

    input.addEventListener("input", function () {
        this.style.height = "auto";
        this.style.height = Math.min(this.scrollHeight, 120) + "px";
        sendBtn.disabled = !this.value.trim() && !pendingImagePath;
    });
    input.addEventListener("keydown", e => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(); }
    });
    sendBtn.addEventListener("click", sendMessage);

    function sendMessage() {
        if (pendingImagePath) {
            conn.invoke("SendImageMessage", adminId, pendingImagePath).catch(console.error);
            pendingImagePath = null;
            document.getElementById("image-preview-wrap").style.display = "none";
            sendBtn.disabled = true;
            return;
        }
        const text = input.value.trim();
        if (!text) return;
        conn.invoke("SendMessage", adminId, text).catch(console.error);
        input.value = "";
        input.style.height = "auto";
        sendBtn.disabled = true;
    }

    // ── Image upload ──────────────────────────────────────────────────────
    document.getElementById("img-file").addEventListener("change", async function () {
        const file = this.files[0];
        if (!file) return;
        const formData = new FormData();
        formData.append("file", file);
        try {
            const resp = await fetch("/Chat/UploadImage", { method: "POST", body: formData });
            if (!resp.ok) { alert("Upload failed: " + await resp.text()); return; }
            const data = await resp.json();
            pendingImagePath = data.path;
            document.getElementById("image-preview").src = pendingImagePath;
            document.getElementById("image-preview-wrap").style.display = "block";
            sendBtn.disabled = false;
        } catch(e) { alert("Error: " + e); }
        this.value = "";
    });
    document.getElementById("cancel-image").addEventListener("click", () => {
        pendingImagePath = null;
        document.getElementById("image-preview-wrap").style.display = "none";
        sendBtn.disabled = !input.value.trim();
    });

    // ── Append new message ────────────────────────────────────────────────
    function appendMessage(msg) {
        const isMine = msg.senderId === myUserId;
        const row = document.createElement("div");
        row.className = "msg-row " + (isMine ? "mine" : "theirs");

        let inner = "";
        if (msg.imagePath) {
            inner += `<img src="${msg.imagePath}" data-src="${msg.imagePath}" class="chat-img" style="max-width:220px;max-height:220px;border-radius:10px;display:block;cursor:pointer;" />`;
        }
        if (msg.message) inner += `<div>${escHtml(msg.message)}</div>`;
        inner += `<div class="ts">${msg.sentAt}</div>`;

        row.innerHTML = `<div class="bubble">${inner}</div>`;
        document.getElementById("chat-end").before(row);

        // Bind lightbox to new image
        row.querySelectorAll(".chat-img").forEach(bindLightbox);
    }

    function escHtml(s) {
        return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    }

    // ── Lightbox ──────────────────────────────────────────────────────────
    const lightbox = document.getElementById("lightbox");
    const lbImg    = document.getElementById("lb-img");

    function bindLightbox(img) {
        img.addEventListener("click", () => {
            lbImg.src = img.dataset.src || img.src;
            lightbox.classList.add("open");
        });
    }
    document.querySelectorAll(".chat-img").forEach(bindLightbox);
    document.getElementById("lightbox").addEventListener("click", e => {
        if (e.target !== lbImg) lightbox.classList.remove("open");
    });

    // ── Scroll ────────────────────────────────────────────────────────────
    function scrollToBottom() {
        const box = document.getElementById("chat-box");
        box.scrollTop = box.scrollHeight;
    }
    scrollToBottom();

    // ── PWA install prompt ────────────────────────────────────────────────
    let deferredPrompt;
    window.addEventListener("beforeinstallprompt", e => {
        e.preventDefault();
        deferredPrompt = e;
        document.getElementById("install-btn").style.display = "inline-block";
    });
    document.getElementById("install-btn").addEventListener("click", async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        deferredPrompt = null;
        if (outcome === "accepted") document.getElementById("install-btn").style.display = "none";
    });
})();
</script>
</body>
</html>
