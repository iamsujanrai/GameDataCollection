@model GameDataCollection.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_UserLayout";
}

<div class="row">
    <!-- Profile Card -->
    <div class="col-md-6 order-1">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user mr-2"></i>My Profile</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Spins Left</dt>
                    <dd class="col-sm-8">
                        <span class="badge badge-@(Model.SpinsRemainingToday > 0 ? "success" : "danger") p-2">
                            @Model.SpinsRemainingToday spin@(Model.SpinsRemainingToday == 1 ? "" : "s") remaining
                        </span>
                        @if (Model.GrantedSpinsRemaining > 0)
                        {
                            <small class="text-muted ml-1">
                                (@Model.FreeSpinsRemaining free + @Model.GrantedSpinsRemaining granted)
                            </small>
                        }
                    </dd>
                </dl>
                @if (Model.SpinsRemainingToday > 0)
                {
                    <a href="@Url.Action("Index", "Spin")" class="btn btn-warning btn-block">
                        <i class="fas fa-sync-alt mr-1"></i> Go Spin the Wheel!
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary btn-block" disabled>
                        <i class="fas fa-clock mr-1"></i>
                        @if (Model.NextSpinAvailableAt.HasValue)
                        {
                            @:Next spin available at @Model.NextSpinAvailableAt.Value.ToLocalTime().ToString("MMM dd, hh:mm tt")
                        }
                        else
                        {
                            @:No spins remaining
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Messages Card — on a phone this sits right after the profile card -->
    <div class="col-12 order-2 order-md-3">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-comments mr-2"></i>Messages</h3>
                <div class="card-tools">
                    <a href="@Url.Action("Index", "Chat")" class="btn btn-tool" title="Open full chat">
                        <i class="fas fa-expand"></i>
                    </a>
                </div>
            </div>
            <div class="card-body p-2">
                <div id="dashChatBox" style="max-height:260px;min-height:120px;overflow-y:auto;">
                    @if (Model.RecentMessages.Any())
                    {
                        foreach (var msg in Model.RecentMessages)
                        {
                            var mine = msg.SenderId == Model.UserId;
                            <div class="d-flex mb-2 @(mine ? "justify-content-end" : "justify-content-start")">
                                <div class="p-2 rounded @(mine ? "bg-primary text-white" : "bg-light")" style="max-width:80%;">
                                    @if (!string.IsNullOrEmpty(msg.Message))
                                    {
                                        <div style="white-space:pre-wrap;word-break:break-word;">@msg.Message</div>
                                    }
                                    @if (!string.IsNullOrEmpty(msg.ImagePath))
                                    {
                                        <a href="@msg.ImagePath" target="_blank">
                                            <img src="@msg.ImagePath" alt="attachment" class="img-fluid rounded" style="max-height:150px;" />
                                        </a>
                                    }
                                    <small class="d-block text-right @(mine ? "text-white-50" : "text-muted")" style="font-size:11px;">
                                        @msg.SentAt.ToLocalTime().ToString("MMM dd, hh:mm tt")
                                    </small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p id="dashChatEmpty" class="text-center text-muted my-4">
                            No messages yet. Send us a message below &mdash; we usually reply quickly.
                        </p>
                    }
                </div>
            </div>
            <div class="card-footer p-2">
                @if (Model.AdminId != null)
                {
                    <div class="d-flex">
                        <input id="dashChatInput" type="text" class="form-control mr-2"
                               placeholder="Type your message..." autocomplete="off" maxlength="1000" />
                        <button id="dashChatSend" type="button" class="btn btn-primary">
                            <i class="fas fa-paper-plane"></i>
                            <span class="d-none d-sm-inline ml-1">Send</span>
                        </button>
                    </div>
                    <small id="dashChatError" class="text-danger" style="display:none;"></small>
                }
                else
                {
                    <small class="text-muted">Messaging is unavailable right now.</small>
                }
            </div>
        </div>
    </div>

    <!-- Game Record Card -->
    <div class="col-md-6 order-3 order-md-2">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-gamepad mr-2"></i>My Game Record</h3>
            </div>
            <div class="card-body">
                @if (Model.GameRecord != null)
                {
                    <dl class="row">
                        <dt class="col-sm-5">Game</dt>
                        <dd class="col-sm-7">@Model.GameRecord.Game?.Name</dd>
                        <dt class="col-sm-5">Game User ID</dt>
                        <dd class="col-sm-7">@Model.GameRecord.GameUserId</dd>
                        <dt class="col-sm-5">State</dt>
                        <dd class="col-sm-7">@Model.GameRecord.State?.Name</dd>
                        <dt class="col-sm-5">Phone</dt>
                        <dd class="col-sm-7">@Model.GameRecord.PhoneNumber</dd>
                        <dt class="col-sm-5">Registered</dt>
                        <dd class="col-sm-7">@Model.GameRecord.CreatedDateTime.ToString("MMM dd, yyyy")</dd>
                    </dl>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle mr-1"></i>
                        No game record found linked to your email address.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Spin History -->
<div class="row">
    <div class="col-12">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-trophy mr-2"></i>My Spin History (Last 20)</h3>
            </div>
            <div class="card-body table-responsive p-0">
                @if (Model.SpinHistory.Any())
                {
                    <table class="table table-hover text-nowrap">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Prize Won</th>
                                <th>Date &amp; Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rowNum = 1; }
                            @foreach (var spin in Model.SpinHistory)
                            {
                                <tr>
                                    <td>@rowNum++</td>
                                    <td><span class="badge badge-warning p-1">@spin.PrizeLabel</span></td>
                                    <td>@spin.SpunAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-spinner fa-2x mb-2"></i>
                        <p>No spins yet. <a href="@Url.Action("Index", "Spin")">Spin the wheel</a> to win prizes!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        (function () {
            var box = document.getElementById('dashChatBox');
            var input = document.getElementById('dashChatInput');
            var sendBtn = document.getElementById('dashChatSend');
            var errorEl = document.getElementById('dashChatError');
            if (!box) return;

            var myId = '@Model.UserId';
            var scrollToEnd = function () { box.scrollTop = box.scrollHeight; };
            scrollToEnd();

            function addBubble(text, imagePath, mine, timeText) {
                var empty = document.getElementById('dashChatEmpty');
                if (empty) empty.remove();

                var row = document.createElement('div');
                row.className = 'd-flex mb-2 ' + (mine ? 'justify-content-end' : 'justify-content-start');

                var bubble = document.createElement('div');
                bubble.className = 'p-2 rounded ' + (mine ? 'bg-primary text-white' : 'bg-light');
                bubble.style.maxWidth = '80%';

                if (text) {
                    var body = document.createElement('div');
                    body.style.whiteSpace = 'pre-wrap';
                    body.style.wordBreak = 'break-word';
                    body.textContent = text;
                    bubble.appendChild(body);
                }
                if (imagePath) {
                    var link = document.createElement('a');
                    link.href = imagePath;
                    link.target = '_blank';
                    var img = document.createElement('img');
                    img.src = imagePath;
                    img.className = 'img-fluid rounded';
                    img.style.maxHeight = '150px';
                    link.appendChild(img);
                    bubble.appendChild(link);
                }

                var time = document.createElement('small');
                time.className = 'd-block text-right ' + (mine ? 'text-white-50' : 'text-muted');
                time.style.fontSize = '11px';
                time.textContent = timeText || '';
                bubble.appendChild(time);

                row.appendChild(bubble);
                box.appendChild(row);
                scrollToEnd();
            }

            // Live updates over the shared connection started by the layout
            if (window.chatHubConn) {
                window.chatHubConn.on('ReceiveMessage', function (msg) {
                    if (msg.senderId === myId) return;      // our own messages are added on send
                    addBubble(msg.message, msg.imagePath, false, msg.sentAt);
                });
            }

            function send() {
                var text = (input.value || '').trim();
                if (!text) return;

                sendBtn.disabled = true;
                errorEl.style.display = 'none';

                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                var form = new FormData();
                form.append('message', text);

                fetch('/Chat/SendToAdmin', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: form
                })
                .then(function (res) {
                    if (!res.ok) throw new Error('send failed');
                    return res.json();
                })
                .then(function (msg) {
                    input.value = '';
                    addBubble(msg.message, msg.imagePath, true, msg.sentAt);
                })
                .catch(function () {
                    errorEl.textContent = 'Could not send. Please check your connection and try again.';
                    errorEl.style.display = '';
                })
                .finally(function () {
                    sendBtn.disabled = false;
                    input.focus();
                });
            }

            sendBtn.addEventListener('click', send);
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); send(); }
            });
        })();
    </script>
}
