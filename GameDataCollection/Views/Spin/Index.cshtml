@{
    ViewData["Title"] = "Spin";
    Layout = "_UserLayout";
}

@Html.AntiForgeryToken()

<div class="spin-page">
    <div class="spin-card">
        <a href="@Url.Action("Index", "UserDashboard")" class="btn btn-secondary btn-sm mb-3">
            &larr; Back to Dashboard
        </a>
        <h2 class="spin-title">🎡 Spin Wheel</h2>

        <div class="stage">
            <div class="pointer"></div>
            <canvas id="wheel" width="360" height="360"></canvas>
        </div>

        <div class="btns">
            <button id="spinBtn" type="button">Spin</button>
        </div>

        <div id="status" class="status">Click Spin to try your luck!</div>
        <div id="winner" class="winner"></div>
    </div>
</div>

<style>
    .spin-page {
        min-height: calc(100vh - 120px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .spin-card {
        width: 420px;
        text-align: center;
        padding: 20px;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,.12);
    }

    .spin-title {
        margin: 0 0 10px;
    }

    .stage {
        position: relative;
        width: 360px;
        height: 360px;
        margin: 14px auto;
    }

    canvas {
        width: 360px;
        height: 360px;
        border-radius: 50%;
        box-shadow: 0 10px 30px rgba(0,0,0,.15);
        transform-origin: 50% 50%;
        background: #fff;
    }

    .pointer {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 0;
        border-left: 14px solid transparent;
        border-right: 14px solid transparent;
        border-bottom: 22px solid #111;
        z-index: 2;
    }

    .btns {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 10px;
    }

    #spinBtn {
        padding: 10px 24px;
        cursor: pointer;
        border-radius: 10px;
        border: 1px solid #ddd;
        background: #111;
        color: #fff;
        font-size: 16px;
    }

        #spinBtn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .status {
        margin-top: 10px;
        font-size: 14px;
        color: #333;
    }

    .winner {
        margin-top: 10px;
        font-weight: 700;
        font-size: 18px;
        color: #28a745;
    }

    .winner.error {
        color: #dc3545;
    }
</style>
<script>
    const canvas = document.getElementById("wheel");
    const ctx = canvas.getContext("2d");
    const statusEl = document.getElementById("status");
    const winnerEl = document.getElementById("winner");
    const spinBtn = document.getElementById("spinBtn");

    // Static prize list matching SpinService prizes
    const items = [
        { title: "$1" },
        { title: "$2" },
        { title: "$5" },
        { title: "$10" },
        { title: "$20" },
        { title: "$50" }
    ];

    let totalRotation = 0;
    let isSpinning = false;

    function hslColor(i, n) {
        const hue = Math.round((i * 360) / n);
        return `hsl(${hue} 70% 55%)`;
    }

    function drawWheel() {
        const w = canvas.width, h = canvas.height;
        const cx = w / 2, cy = h / 2;
        const radius = Math.min(cx, cy) - 6;

        ctx.clearRect(0, 0, w, h);

        const n = items.length;
        const arc = (Math.PI * 2) / n;

        for (let i = 0; i < n; i++) {
            const start = i * arc;
            const end = start + arc;

            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, radius, start, end);
            ctx.closePath();
            ctx.fillStyle = hslColor(i, n);
            ctx.fill();

            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(start + arc / 2);
            ctx.textAlign = "right";
            ctx.fillStyle = "#111";
            ctx.font = "bold 16px Arial";
            ctx.fillText(items[i].title, radius - 12, 5);
            ctx.restore();
        }

        // Center circle
        ctx.beginPath();
        ctx.arc(cx, cy, 34, 0, Math.PI * 2);
        ctx.fillStyle = "#fff";
        ctx.fill();
        ctx.strokeStyle = "rgba(0,0,0,.1)";
        ctx.stroke();

        ctx.fillStyle = "#111";
        ctx.font = "bold 14px Arial";
        ctx.textAlign = "center";
        ctx.fillText("SPIN", cx, cy + 5);
    }

    function setWheelRotation(deg) {
        canvas.style.transition = "transform 5s cubic-bezier(.17,.67,.12,1)";
        canvas.style.transform = `rotate(${deg}deg)`;
    }

    async function spin() {
        if (isSpinning) return;

        isSpinning = true;
        spinBtn.disabled = true;
        winnerEl.textContent = "";
        winnerEl.className = "winner";
        statusEl.textContent = "Spinning…";

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        let data;
        try {
            const res = await fetch("/Spin/Spin", {
                method: "POST",
                headers: { "RequestVerificationToken": token }
            });

            data = await res.json();

            if (!res.ok) {
                winnerEl.textContent = data.message || "Spin failed.";
                winnerEl.className = "winner error";
                statusEl.textContent = "";
                isSpinning = false;
                spinBtn.disabled = false;
                return;
            }
        } catch (e) {
            winnerEl.textContent = "Network error. Please try again.";
            winnerEl.className = "winner error";
            statusEl.textContent = "";
            isSpinning = false;
            spinBtn.disabled = false;
            return;
        }

        // Compute exact rotation so pointer lands on the winning segment
        const sliceAngle = 360 / items.length;
        // Canvas draws slices from 0° (3-o'clock), pointer is fixed at 270° (12-o'clock).
        // After CSS clockwise rotation X, pointer aligns with canvas angle (270 - X) % 360.
        // To land on center of prizeIndex: X = (270 - (prizeIndex*sliceAngle + sliceAngle/2) + 360) % 360
        const targetAngle = (270 - (data.prizeIndex * sliceAngle + sliceAngle / 2) + 360) % 360;
        const currentAngle = totalRotation % 360;
        let delta = targetAngle - currentAngle;
        if (delta <= 0) delta += 360;
        totalRotation += 5 * 360 + delta;
        setWheelRotation(totalRotation);

        setTimeout(() => {
            statusEl.textContent = "Done! 🎉";
            winnerEl.textContent = `You won: ${data.prizeLabel}!`;
            winnerEl.className = "winner";
            isSpinning = false;
            spinBtn.disabled = false;
        }, 5100);
    }

    spinBtn.addEventListener("click", spin);

    // Draw wheel on load
    drawWheel();
</script>
