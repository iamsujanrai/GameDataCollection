@{
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Spin Wheel</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            padding: 30px;
        }

        .wrap {
            width: 420px;
            text-align: center;
        }

        .stage {
            position: relative;
            width: 360px;
            height: 360px;
            margin: 14px auto;
        }

        canvas {
            width: 360px;
            height: 360px;
            border-radius: 50%;
            box-shadow: 0 10px 30px rgba(0,0,0,.15);
            transform: rotate(0deg);
            transition: transform 4s cubic-bezier(.17,.67,.12,1);
            background: #fff;
            transform-origin: 50% 50%;
        }

        .pointer {
            position: absolute;
            top: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 0;
            border-left: 14px solid transparent;
            border-right: 14px solid transparent;
            border-bottom: 22px solid #111;
            z-index: 2;
        }

        .btns {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 10px;
        }

        button {
            padding: 10px 16px;
            cursor: pointer;
            border-radius: 10px;
            border: 1px solid #ddd;
            background: #111;
            color: #fff;
        }

            button:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .meta {
            margin-top: 10px;
            font-size: 14px;
            color: #333;
        }

        .winner {
            margin-top: 10px;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="wrap">
        <h2>🎡 Spin Wheel</h2>

        <div class="stage">
            <div class="pointer"></div>
            <canvas id="wheel" width="360" height="360"></canvas>
        </div>

        <div class="btns">
            <button id="loadBtn">Load</button>
            <button id="spinBtn" disabled>Spin</button>
        </div>

        <div class="meta" id="status">Click Load to fetch items…</div>
        <div class="winner" id="winner"></div>
    </div>

</body>
</html>
<script>
    const canvas = document.getElementById("wheel");
    const ctx = canvas.getContext("2d");
    const statusEl = document.getElementById("status");
    const winnerEl = document.getElementById("winner");
    const loadBtn = document.getElementById("loadBtn");
    const spinBtn = document.getElementById("spinBtn");

    let items = [];
    let currentRotation = 0;   // 0..359 (where the wheel is currently pointing)
    let totalRotation = 0;     // keeps growing to ensure smooth animation every time
    let isSpinning = false;

    function hslColor(i, n) {
        const hue = Math.round((i * 360) / n);
        return `hsl(${hue} 70% 55%)`;
    }

    function drawWheel() {
        const w = canvas.width, h = canvas.height;
        const cx = w / 2, cy = h / 2;
        const radius = Math.min(cx, cy) - 6;

        ctx.clearRect(0, 0, w, h);

        if (!items.length) {
            ctx.fillStyle = "#222";
            ctx.font = "16px Arial";
            ctx.textAlign = "center";
            ctx.fillText("No items loaded", cx, cy);
            return;
        }

        const n = items.length;
        const arc = (Math.PI * 2) / n;

        for (let i = 0; i < n; i++) {
            const start = i * arc;
            const end = start + arc;

            // Slice
            ctx.beginPath();
            ctx.moveTo(cx, cy);
            ctx.arc(cx, cy, radius, start, end);
            ctx.closePath();
            ctx.fillStyle = hslColor(i, n);
            ctx.fill();

            // Text
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(start + arc / 2);
            ctx.textAlign = "right";
            ctx.fillStyle = "#111";
            ctx.font = "bold 14px Arial";
            const label = items[i].title ?? items[i].Title ?? "";
            ctx.fillText(label.length > 18 ? label.slice(0, 18) + "…" : label, radius - 12, 5);
            ctx.restore();
        }

        // Center circle
        ctx.beginPath();
        ctx.arc(cx, cy, 34, 0, Math.PI * 2);
        ctx.fillStyle = "#fff";
        ctx.fill();
        ctx.strokeStyle = "rgba(0,0,0,.1)";
        ctx.stroke();

        ctx.fillStyle = "#111";
        ctx.font = "bold 14px Arial";
        ctx.textAlign = "center";
        ctx.fillText("SPIN", cx, cy + 5);
    }

    async function loadItems() {
        winnerEl.textContent = "";
        statusEl.textContent = "Loading items…";
        spinBtn.disabled = true;

        const res = await fetch("/api/spin/list");
        if (!res.ok) {
            statusEl.textContent = "Failed to load.";
            return;
        }

        items = await res.json();
        if (!Array.isArray(items) || items.length < 2) {
            statusEl.textContent = "Need at least 2 items.";
            drawWheel();
            return;
        }

        drawWheel();
        statusEl.textContent = `Loaded ${items.length} items ✅`;
        spinBtn.disabled = false;
    }

    function setWheelRotation(deg) {
        // ✅ always 5 seconds animation
        canvas.style.transition = "transform 5s cubic-bezier(.17,.67,.12,1)";
        canvas.style.transform = `rotate(${deg}deg)`;
    }

    async function spin() {
        if (!items.length || isSpinning) return;

        isSpinning = true;
        spinBtn.disabled = true;
        loadBtn.disabled = true;
        winnerEl.textContent = "";
        statusEl.textContent = "Spinning…";

        const res = await fetch("/api/spin/generate", { method: "POST" });
        const data = await res.json();

        if (!res.ok || data?.message) {
            statusEl.textContent = data?.message || "Spin failed.";
            isSpinning = false;
            spinBtn.disabled = false;
            loadBtn.disabled = false;
            return;
        }

        // winner index (by rewardId)
        const rewardId = data.rewardId;
        const idx = items.findIndex(x => (x.id ?? x.Id) === rewardId);

        if (idx === -1) {
            statusEl.textContent = "Winner not found. Reload wheel.";
            isSpinning = false;
            spinBtn.disabled = false;
            loadBtn.disabled = false;
            return;
        }

        const n = items.length;
        const sliceDeg = 360 / n;

        // slice center angle (0° = 3 o'clock)
        const sliceCenter = (idx * sliceDeg) + (sliceDeg / 2);

        // pointer at TOP = 270°
        const pointerDeg = 270;

        // desiredRotation (0..359) that puts sliceCenter under pointer
        const desiredRotation = ((pointerDeg - sliceCenter) % 360 + 360) % 360;

        // rotate forward from currentRotation to desiredRotation
        const delta = ((desiredRotation - currentRotation) % 360 + 360) % 360;

        // ✅ full spins first (5 seconds)
        const fullSpins = 6;

        // ✅ keep totalRotation increasing so every spin animates correctly
        totalRotation = totalRotation + (fullSpins * 360) + delta;

        // update currentRotation for next spins
        currentRotation = desiredRotation;

        // rotate wheel
        setWheelRotation(totalRotation);

        // Wait for CSS transition end (5s)
        setTimeout(() => {
            statusEl.textContent = "Done ✅";
            winnerEl.textContent = `🎉 You won: ${data.title} (Amount: ${data.amount})`;

            isSpinning = false;
            spinBtn.disabled = false;
            loadBtn.disabled = false;
        }, 5100);
    }

    loadBtn.addEventListener("click", loadItems);
    spinBtn.addEventListener("click", spin);

    // Initial draw
    drawWheel();
</script>