@model List<GameDataCollection.Models.SpinPrize>
@{
    ViewData["Title"] = "Lucky Wheel";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lucky Wheel</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100dvh;
            background:
                radial-gradient(ellipse at 50% 30%, #6a1fb5 0%, #40107d 40%, #1d0646 75%, #0c0226 100%);
            font-family: 'Segoe UI', Arial, sans-serif;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ── Twinkling stars ── */
        .stars { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
        .star {
            position: absolute;
            background: #fff;
            border-radius: 50%;
            animation: twinkle var(--d, 3s) ease-in-out infinite var(--delay, 0s);
        }
        @@keyframes twinkle {
            0%,100% { opacity: .15; transform: scale(1); }
            50%      { opacity: 1;   transform: scale(1.4); }
        }

        /* ── Floating prize icons ── */
        .sparkle {
            position: fixed;
            pointer-events: none;
            font-size: var(--sz, 18px);
            animation: float var(--d, 4s) ease-in-out infinite var(--delay, 0s);
            z-index: 0;
            opacity: .8;
            filter: drop-shadow(0 3px 6px rgba(0,0,0,.5));
        }
        @@keyframes float {
            0%,100% { transform: translateY(0) rotate(-8deg); }
            50%      { transform: translateY(-16px) rotate(8deg); }
        }

        /* ── Layout ── */
        .page {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 16px 28px;
        }

        /* ── Back ── */
        .back-btn {
            position: fixed;
            top: 14px;
            left: 14px;
            z-index: 10;
            color: #ffd700;
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,215,0,.3);
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 13px;
            text-decoration: none;
            backdrop-filter: blur(6px);
            transition: background .2s;
        }
        .back-btn:hover { background: rgba(255,215,0,.2); color: #ffd700; }

        /* ── Title ── */
        .title-wrap { text-align: center; margin-bottom: 6px; }

        .lucky-label {
            font-size: 11px;
            letter-spacing: 3px;
            color: #ffd700;
            text-transform: uppercase;
            opacity: .75;
        }

        .lucky-title {
            font-size: clamp(26px, 6vw, 42px);
            font-weight: 900;
            letter-spacing: 3px;
            text-transform: uppercase;
            background: linear-gradient(180deg, #fff7a0 0%, #ffd700 40%, #ff9900 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 2px 8px rgba(255,180,0,.7));
            line-height: 1.15;
        }

        .subtitle {
            margin-top: 4px;
            font-size: 12px;
            color: rgba(255,255,255,.55);
            max-width: 300px;
            line-height: 1.5;
            text-align: center;
        }

        /* ── Wheel stage ── */
        .stage-wrap {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 8px 0 4px;
        }

        .stage { position: relative; }

        /* Glow behind the wheel */
        .stage::before {
            content: '';
            position: absolute;
            inset: -22px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,190,60,.25) 0%, transparent 70%);
            animation: pulseGlow 2.5s ease-in-out infinite;
        }
        @@keyframes pulseGlow {
            0%,100% { opacity: .55; transform: scale(1); }
            50%      { opacity: 1;   transform: scale(1.06); }
        }

        .stage canvas {
            position: absolute;
            inset: 0;
            display: block;
        }
        /* The segments spin, the gold frame and bulbs stay still */
        #wheel { z-index: 2; transform-origin: 50% 50%; }
        #frame { z-index: 3; pointer-events: none; }

        /* Pointer */
        .pointer {
            position: absolute;
            top: -16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 6;
            filter: drop-shadow(0 3px 7px rgba(0,0,0,.55));
            transform-origin: 50% 18%;
        }
        .pointer.ticking { animation: tick .09s linear infinite; }
        @@keyframes tick {
            0%,100% { transform: translateX(-50%) rotate(0deg); }
            50%      { transform: translateX(-50%) rotate(-11deg); }
        }

        /* ── SPIN button ── */
        .spin-btn-wrap { margin-top: 16px; }

        #spinBtn {
            padding: 15px 58px;
            font-size: 21px;
            font-weight: 900;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #6a2a00;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            background: linear-gradient(180deg, #fff6b0 0%, #ffd23f 45%, #ffa400 100%);
            box-shadow:
                0 0 0 4px rgba(255,170,0,.25),
                0 6px 22px rgba(255,160,0,.55),
                inset 0 2px 0 rgba(255,255,255,.65);
            transition: transform .15s, box-shadow .15s;
            position: relative;
            overflow: hidden;
            text-shadow: 0 1px 0 rgba(255,255,255,.5);
        }
        #spinBtn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent);
            animation: shimmer 2.5s infinite;
        }
        @@keyframes shimmer {
            0%   { left: -100%; }
            100% { left: 200%; }
        }
        #spinBtn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow:
                0 0 0 4px rgba(255,170,0,.35),
                0 10px 28px rgba(255,160,0,.7),
                inset 0 2px 0 rgba(255,255,255,.65);
        }
        #spinBtn:active:not(:disabled) { transform: translateY(0); }
        #spinBtn:disabled { opacity: .55; cursor: not-allowed; }
        #spinBtn:disabled::before { display: none; }

        /* ── Status & Winner ── */
        .status-wrap { min-height: 54px; text-align: center; margin-top: 12px; }

        #status { font-size: 13px; color: rgba(255,255,255,.55); }

        #winner {
            font-size: 19px;
            font-weight: 800;
            margin-top: 6px;
            color: #ffd700;
            text-shadow: 0 0 12px rgba(255,215,0,.6);
        }
        #winner.error { color: #ff6b6b; text-shadow: none; }
    </style>
</head>
<body>

@Html.AntiForgeryToken()

<!-- Stars -->
<div class="stars" id="stars"></div>

<!-- Floating prize icons -->
<span class="sparkle" style="--sz:26px;--d:3.5s;--delay:0s;top:8%;left:5%;">&#127873;</span>
<span class="sparkle" style="--sz:20px;--d:4s;--delay:.5s;top:15%;left:88%;">&#129689;</span>
<span class="sparkle" style="--sz:22px;--d:5s;--delay:1s;top:72%;left:4%;">&#128142;</span>
<span class="sparkle" style="--sz:18px;--d:3s;--delay:1.5s;top:82%;left:92%;">&#127873;</span>
<span class="sparkle" style="--sz:24px;--d:4.5s;--delay:.3s;top:40%;left:93%;">&#11088;</span>
<span class="sparkle" style="--sz:20px;--d:3.8s;--delay:.8s;top:55%;left:2%;">&#129689;</span>
<span class="sparkle" style="--sz:16px;--d:2.8s;--delay:2s;top:25%;left:76%;">&#10024;</span>
<span class="sparkle" style="--sz:26px;--d:5.5s;--delay:.2s;top:62%;left:82%;">&#127881;</span>

<!-- Back -->
<a href="@Url.Action("Index", "UserDashboard")" class="back-btn">&#8592; Dashboard</a>

<div class="page">
    <!-- Title -->
    <div class="title-wrap">
        <div class="lucky-label">&#9733; Try Your Luck &#9733;</div>
        <div class="lucky-title">Lucky Wheel</div>
        <div class="subtitle">Spin the wheel and win amazing prizes every day!</div>
    </div>

    <!-- Wheel -->
    <div class="stage-wrap">
        <div class="stage" id="stage">
            <svg class="pointer" id="pointer" width="46" height="62" viewBox="0 0 46 62" aria-hidden="true">
                <defs>
                    <linearGradient id="pgGold" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#fff7bd" />
                        <stop offset="45%" stop-color="#ffd23f" />
                        <stop offset="100%" stop-color="#c17f00" />
                    </linearGradient>
                    <radialGradient id="pgJewel" cx="35%" cy="30%">
                        <stop offset="0%" stop-color="#ff8f8f" />
                        <stop offset="60%" stop-color="#e8243c" />
                        <stop offset="100%" stop-color="#8d0f20" />
                    </radialGradient>
                </defs>
                <path d="M23 60 L6 26 A19 19 0 0 1 40 26 Z" fill="url(#pgGold)" stroke="#8a5a00" stroke-width="1.5" stroke-linejoin="round" />
                <circle cx="23" cy="19" r="15" fill="url(#pgGold)" stroke="#8a5a00" stroke-width="1.5" />
                <circle cx="23" cy="19" r="8" fill="url(#pgJewel)" stroke="#ffe9a8" stroke-width="1.5" />
            </svg>
            <canvas id="wheel"></canvas>
            <canvas id="frame"></canvas>
        </div>
    </div>

    <!-- Spin button -->
    <div class="spin-btn-wrap">
        <button id="spinBtn" type="button">SPIN</button>
    </div>

    <!-- Feedback -->
    <div class="status-wrap">
        <div id="status">Tap SPIN to try your luck!</div>
        <div id="winner"></div>
    </div>
</div>

<script>
    // ── Background stars ─────────────────────────────────────
    (function () {
        const c = document.getElementById('stars');
        for (let i = 0; i < 80; i++) {
            const s = document.createElement('div');
            s.className = 'star';
            const sz = Math.random() * 2.5 + 0.5;
            s.style.cssText = `
                width:${sz}px; height:${sz}px;
                top:${Math.random()*100}%;
                left:${Math.random()*100}%;
                --d:${(Math.random()*4+2).toFixed(1)}s;
                --delay:-${(Math.random()*4).toFixed(1)}s;
            `;
            c.appendChild(s);
        }
    })();

    // ── Prize data ───────────────────────────────────────────
    const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Select(p => new { title = p.Label, amount = p.Amount })));

    const wheelCv  = document.getElementById('wheel');
    const frameCv  = document.getElementById('frame');
    const stage    = document.getElementById('stage');
    const pointer  = document.getElementById('pointer');
    const statusEl = document.getElementById('status');
    const winnerEl = document.getElementById('winner');
    const spinBtn  = document.getElementById('spinBtn');

    const wctx = wheelCv.getContext('2d');
    const fctx = frameCv.getContext('2d');

    let totalRotation = 0;
    let isSpinning    = false;
    let S             = 0;   // stage size in CSS pixels
    let dpr           = 1;   // device pixel ratio, so the wheel stays sharp

    // ── Segment colours (bright carnival palette) ────────────
    // Ordered so neighbouring slices never share a hue
    const PALETTE = [
        ['#ff2f4e', '#c70026'],  // red
        ['#ffc400', '#e08b00'],  // yellow
        ['#36c94e', '#199b2f'],  // green
        ['#17b6e8', '#0b7fab'],  // cyan
        ['#2a7bff', '#0f46b8'],  // blue
        ['#8a3ffc', '#5a1bbd'],  // purple
        ['#e9318f', '#aa0b5d'],  // pink
        ['#ff7a18', '#d14b00'],  // orange
        ['#00c2b2', '#00897f'],  // teal
        ['#7fc62b', '#4f8a10'],  // lime
        ['#ff9f1a', '#cc6f00'],  // amber
        ['#ff5fa2', '#cf2473']   // rose
    ];

    const MONEY_ICONS   = ['\u{1F381}', '\u{1F340}', '\u{1F48E}', '\u{1F389}'];   // gift, clover, diamond, party
    const PERCENT_ICONS = ['\u{2B50}', '\u{1F525}', '\u{1F4AF}'];                 // star, fire, 100
    const LOSE_ICON     = '\u{1F61E}';                                            // sad face

    // Split "$5 Free Play" into a big headline and a small sub-line
    function parseLabel(label) {
        const text = (label || '').trim();
        const m = text.match(/^(\$\s*\d+(?:\.\d+)?|\d+(?:\.\d+)?\s*%)\s*(.*)$/);
        if (m) return { head: m[1].replace(/\s+/g, ''), sub: m[2].trim(), big: true };

        const words = text.split(/\s+/);
        if (words.length <= 2) return { head: text, sub: '', big: false };
        const half = Math.ceil(words.length / 2);
        return { head: words.slice(0, half).join(' '), sub: words.slice(half).join(' '), big: false };
    }

    // Work out the icon, colours and "lucky prize" flag for every segment
    const segments = (function () {
        let money = 0, percent = 0;
        let bestIdx = -1, bestAmount = 0;

        const segs = items.map((it, i) => {
            const label  = it.title || '';
            const amount = Number(it.amount) || 0;
            const parts  = parseLabel(label);
            const isLoss = amount <= 0 && !/%/.test(label);

            let icon;
            if (isLoss)              icon = LOSE_ICON;
            else if (/%/.test(label)) icon = PERCENT_ICONS[percent++ % PERCENT_ICONS.length];
            else                      icon = MONEY_ICONS[money++ % MONEY_ICONS.length];

            if (!isLoss && amount > bestAmount) { bestAmount = amount; bestIdx = i; }

            return { label, amount, icon, isLoss, lucky: false, ...parts };
        });

        // Mark the biggest prize so it gets the LUCKY PRIZE ribbon
        if (bestIdx >= 0 && segs.length > 2) segs[bestIdx].lucky = true;
        return segs;
    })();

    // ── Helpers ──────────────────────────────────────────────
    function setFont(ctx, weight, size) {
        ctx.font = `${weight} ${size}px "Segoe UI", "Trebuchet MS", Arial, sans-serif`;
    }

    // Shrink the font until the text fits the slice at that radius
    function fitFont(ctx, text, maxW, startSize, minSize, weight) {
        let size = startSize;
        setFont(ctx, weight, size);
        while (ctx.measureText(text).width > maxW && size > minSize) {
            size -= 1;
            setFont(ctx, weight, size);
        }
        return size;
    }

    // Draw text across the slice (tangential), flipped on the lower half so it is never upside down
    function radialText(ctx, text, mid, dist, size, weight, color, maxW) {
        const flip = Math.sin(mid) > 0;
        ctx.save();
        ctx.rotate(flip ? mid - Math.PI / 2 : mid + Math.PI / 2);
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = color;
        const used = fitFont(ctx, text, maxW, size, 7, weight);
        ctx.shadowColor = 'rgba(0,0,0,.45)';
        ctx.shadowBlur = 3;
        ctx.shadowOffsetY = 1;
        ctx.fillText(text, 0, flip ? dist : -dist);
        ctx.restore();
        return used;
    }

    function roundRect(ctx, x, y, w, h, r) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
    }

    // ── The spinning part: coloured slices, icons and labels ──
    function drawWheel() {
        const R   = S / 2;
        const Rw  = R - 30;             // segments stop where the gold rim starts
        const n   = segments.length;
        const arc = (Math.PI * 2) / n;

        wctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        wctx.clearRect(0, 0, S, S);
        wctx.translate(R, R);

        // Pass 1 — slice fills and dividers
        for (let i = 0; i < n; i++) {
            const start = i * arc;
            const [c1, c2] = PALETTE[i % PALETTE.length];

            // Slice fill: lighter at the rim, deeper near the hub
            const g = wctx.createRadialGradient(0, 0, Rw * 0.12, 0, 0, Rw);
            g.addColorStop(0, c2);
            g.addColorStop(0.55, c1);
            g.addColorStop(1, c1);

            wctx.beginPath();
            wctx.moveTo(0, 0);
            wctx.arc(0, 0, Rw, start, start + arc);
            wctx.closePath();
            wctx.fillStyle = g;
            wctx.fill();

            // White divider between slices
            wctx.save();
            wctx.beginPath();
            wctx.moveTo(0, 0);
            wctx.lineTo(Rw * Math.cos(start), Rw * Math.sin(start));
            wctx.strokeStyle = 'rgba(255,255,255,.55)';
            wctx.lineWidth = 2;
            wctx.stroke();
            wctx.restore();
        }

        // Soft shading over the whole wheel for depth
        const shade = wctx.createRadialGradient(0, -Rw * 0.3, Rw * 0.1, 0, 0, Rw);
        shade.addColorStop(0, 'rgba(255,255,255,.14)');
        shade.addColorStop(0.6, 'rgba(255,255,255,0)');
        shade.addColorStop(1, 'rgba(0,0,0,.18)');
        wctx.beginPath();
        wctx.arc(0, 0, Rw, 0, Math.PI * 2);
        wctx.fillStyle = shade;
        wctx.fill();

        // Pass 2 — icons, labels and ribbon, so nothing is painted over by a later slice
        for (let i = 0; i < n; i++) {
            const seg = segments[i];
            const mid = i * arc + arc / 2;

            // Icon, headline and sub-line. On the lower half the text flips so it stays
            // readable, so the radii are mirrored too and the icon keeps sitting above the text.
            const flip  = Math.sin(mid) > 0;
            const chord = (d) => Math.max(26, 2 * d * Math.sin(arc / 2) * 0.86);
            // The lucky slice is pushed outwards to leave room for its ribbon
            const stack = seg.lucky ? [0.88, 0.70, 0.56] : [0.80, 0.56, 0.40];
            const [iconF, headF, subF] = flip ? [stack[2], stack[1], stack[0]] : stack;

            const iconR = Rw * iconF;
            radialText(wctx, seg.icon, mid, iconR, Math.min(Rw * 0.15, chord(iconR) * 0.85), '400', '#fff', chord(iconR));

            const headR = Rw * headF;
            radialText(wctx, seg.head, mid, headR, seg.big ? Rw * 0.15 : Rw * 0.1, '900', '#ffffff', chord(headR));

            if (seg.sub) {
                const subR = Rw * subF;
                radialText(wctx, seg.sub, mid, subR, Rw * 0.085, '700', '#ffffff', chord(subR));
            }

            // LUCKY PRIZE ribbon on the biggest prize
            if (seg.lucky) {
                const bR = Rw * 0.4;
                wctx.save();
                wctx.rotate(flip ? mid - Math.PI / 2 : mid + Math.PI / 2);
                wctx.translate(0, flip ? bR : -bR);
                wctx.rotate(-0.12);
                const bw = Math.max(chord(bR) * 1.25, Rw * 0.42);
                const bh = Math.max(14, Rw * 0.115);
                roundRect(wctx, -bw / 2, -bh / 2, bw, bh, bh / 2);
                wctx.fillStyle = '#e8243c';
                wctx.strokeStyle = '#ffe08a';
                wctx.lineWidth = 1.5;
                wctx.fill();
                wctx.stroke();
                wctx.fillStyle = '#fff';
                wctx.textAlign = 'center';
                wctx.textBaseline = 'middle';
                wctx.shadowColor = 'transparent';
                fitFont(wctx, 'LUCKY PRIZE', bw * 0.86, bh * 0.66, 7, '900');
                wctx.fillText('LUCKY PRIZE', 0, 0.5);
                wctx.restore();
            }
        }
    }

    // ── The still part: gold rim, blinking bulbs and hub ─────
    function drawFrame(phase) {
        const R     = S / 2;
        const outer = R - 1;
        const inner = R - 30;

        fctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        fctx.clearRect(0, 0, S, S);
        fctx.translate(R, R);

        // Gold ring
        const rim = fctx.createRadialGradient(0, 0, inner, 0, 0, outer);
        rim.addColorStop(0,    '#8a5a00');
        rim.addColorStop(0.18, '#ffe9a8');
        rim.addColorStop(0.45, '#f0b429');
        rim.addColorStop(0.75, '#ffd978');
        rim.addColorStop(1,    '#9c6500');
        fctx.beginPath();
        fctx.arc(0, 0, outer, 0, Math.PI * 2);
        fctx.arc(0, 0, inner, 0, Math.PI * 2, true);
        fctx.fillStyle = rim;
        fctx.fill('evenodd');

        // Thin dark edges so the rim reads as metal
        fctx.beginPath();
        fctx.arc(0, 0, outer - 0.5, 0, Math.PI * 2);
        fctx.strokeStyle = 'rgba(90,55,0,.8)';
        fctx.lineWidth = 1.5;
        fctx.stroke();
        fctx.beginPath();
        fctx.arc(0, 0, inner + 1, 0, Math.PI * 2);
        fctx.strokeStyle = 'rgba(120,70,0,.65)';
        fctx.lineWidth = 2;
        fctx.stroke();

        // Marquee bulbs, every other one lit
        const bulbs  = Math.max(16, Math.min(28, segments.length * 2));
        const bulbR  = Math.max(4, S * 0.016);
        const ringR  = (outer + inner) / 2;
        for (let i = 0; i < bulbs; i++) {
            const a  = (i / bulbs) * Math.PI * 2 - Math.PI / 2;
            const bx = ringR * Math.cos(a);
            const by = ringR * Math.sin(a);
            const on = (i % 2) === phase;

            if (on) {
                fctx.beginPath();
                fctx.arc(bx, by, bulbR * 2.1, 0, Math.PI * 2);
                fctx.fillStyle = 'rgba(255,240,170,.33)';
                fctx.fill();
            }

            const bg = fctx.createRadialGradient(bx - bulbR * 0.35, by - bulbR * 0.35, bulbR * 0.2, bx, by, bulbR);
            bg.addColorStop(0, on ? '#ffffff' : '#fff6d5');
            bg.addColorStop(1, on ? '#ffd84d' : '#c89b2c');
            fctx.beginPath();
            fctx.arc(bx, by, bulbR, 0, Math.PI * 2);
            fctx.fillStyle = bg;
            fctx.fill();
            fctx.strokeStyle = 'rgba(120,80,0,.5)';
            fctx.lineWidth = 1;
            fctx.stroke();
        }

        // Centre hub
        const hubR = Math.max(26, S * 0.085);
        fctx.beginPath();
        fctx.arc(0, 0, hubR + 4, 0, Math.PI * 2);
        fctx.fillStyle = 'rgba(0,0,0,.28)';
        fctx.fill();

        const hub = fctx.createLinearGradient(-hubR, -hubR, hubR, hubR);
        hub.addColorStop(0,   '#fff7bd');
        hub.addColorStop(0.45, '#ffd23f');
        hub.addColorStop(1,   '#b87a00');
        fctx.beginPath();
        fctx.arc(0, 0, hubR, 0, Math.PI * 2);
        fctx.fillStyle = hub;
        fctx.fill();
        fctx.strokeStyle = '#8a5a00';
        fctx.lineWidth = 2;
        fctx.stroke();

        fctx.beginPath();
        fctx.arc(0, 0, hubR * 0.62, 0, Math.PI * 2);
        fctx.fillStyle = '#ffe9a8';
        fctx.fill();

        fctx.fillStyle = '#b87a00';
        fctx.textAlign = 'center';
        fctx.textBaseline = 'middle';
        setFont(fctx, '900', hubR * 0.75);
        fctx.fillText('★', 0, hubR * 0.04);
    }

    // ── Size the canvases to the screen (sharp on retina) ────
    function layout() {
        const avail = Math.min(window.innerWidth - 36, window.innerHeight - 330);
        S = Math.max(240, Math.min(390, avail));
        dpr = window.devicePixelRatio || 1;

        stage.style.width  = S + 'px';
        stage.style.height = S + 'px';

        for (const cv of [wheelCv, frameCv]) {
            cv.width  = Math.round(S * dpr);
            cv.height = Math.round(S * dpr);
            cv.style.width  = S + 'px';
            cv.style.height = S + 'px';
        }

        drawWheel();
        drawFrame(blinkPhase);
    }

    // Blinking bulbs
    let blinkPhase = 0;
    setInterval(() => {
        blinkPhase = blinkPhase ? 0 : 1;
        drawFrame(blinkPhase);
    }, 550);

    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(layout, 150);
    });

    // ── Spin ─────────────────────────────────────────────────
    function setWheelRotation(deg) {
        wheelCv.style.transition = 'transform 5s cubic-bezier(.17,.67,.12,1)';
        wheelCv.style.transform  = `rotate(${deg}deg)`;
    }

    async function spin() {
        if (isSpinning) return;
        isSpinning = true;
        spinBtn.disabled = true;
        winnerEl.textContent = '';
        winnerEl.className   = '';
        statusEl.textContent = 'Spinning…';

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let data;
        try {
            const res = await fetch('/Spin/Spin', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            data = await res.json();
            if (!res.ok) {
                winnerEl.textContent = data.message || 'Spin failed.';
                winnerEl.className   = 'error';
                statusEl.textContent = '';
                isSpinning = false; spinBtn.disabled = false;
                return;
            }
        } catch {
            winnerEl.textContent = 'Network error. Please try again.';
            winnerEl.className   = 'error';
            statusEl.textContent = '';
            isSpinning = false; spinBtn.disabled = false;
            return;
        }

        // Land the winning slice under the pointer
        const sliceAngle   = 360 / segments.length;
        const targetAngle  = (270 - (data.prizeIndex * sliceAngle + sliceAngle / 2) + 360) % 360;
        const currentAngle = totalRotation % 360;
        let delta = targetAngle - currentAngle;
        if (delta <= 0) delta += 360;
        totalRotation += 5 * 360 + delta;
        setWheelRotation(totalRotation);
        pointer.classList.add('ticking');
        setTimeout(() => pointer.classList.remove('ticking'), 4600);

        setTimeout(() => {
            // A zero-amount slice (e.g. "Better Luck Next Time") isn't a win
            const isWin = Number(data.prizeAmount) > 0 || /%/.test(data.prizeLabel || '');
            statusEl.textContent = isWin ? '🎉 Congratulations!' : '😔 Not this time';
            winnerEl.textContent = isWin ? `You won: ${data.prizeLabel}!` : `${data.prizeLabel}`;
            winnerEl.className   = '';
            isSpinning = false;
            spinBtn.disabled = false;
        }, 5200);
    }

    spinBtn.addEventListener('click', spin);
    layout();
</script>
</body>
</html>
