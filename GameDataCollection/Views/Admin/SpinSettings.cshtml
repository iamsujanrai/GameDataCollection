@model GameDataCollection.ViewModels.SpinSettingViewModel
@{
    ViewData["Title"] = "Spin Settings";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-cog mr-2"></i>Spin Cooldown Settings</h3>
            </div>
            <form asp-action="SpinSettings" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="MaxSpinsPerPeriod" type="hidden" />
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-1"></i>
                        Each user gets <strong>1 spin</strong> automatically after the cooldown period.
                        The spin does not stack — if unused, no extra spin is added on the next reset.
                        Admin-granted spins are added separately and always stack.
                    </div>

                    <div class="form-group">
                        <label asp-for="CooldownHours"></label>
                        <input asp-for="CooldownHours" class="form-control" type="number" min="1" max="720" />
                        <span asp-validation-for="CooldownHours" class="text-danger"></span>
                        <small class="form-text text-muted">
                            e.g. 24 = 1 spin per day &nbsp;|&nbsp; 12 = 1 spin every 12 hours &nbsp;|&nbsp; 1 = 1 spin per hour
                        </small>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i> Save Settings
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
