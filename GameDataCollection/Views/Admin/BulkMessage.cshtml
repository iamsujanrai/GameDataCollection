@model List<GameDataCollection.Models.User>
@{
    ViewData["Title"] = "Bulk Message";
}

<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-bullhorn mr-2"></i>Send Bulk Message</h3>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible mx-3 mt-3 mb-0">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="fas fa-check-circle mr-1"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible mx-3 mt-3 mb-0">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="fas fa-exclamation-circle mr-1"></i> @TempData["Error"]
                </div>
            }

            <form method="post" asp-action="BulkMessage" asp-controller="Chat">
                @Html.AntiForgeryToken()
                <div class="card-body">

                    <!-- Message box -->
                    <div class="form-group">
                        <label for="message"><strong>Message</strong></label>
                        <textarea id="message" name="message" class="form-control" rows="4"
                                  placeholder="Type your message here..." required></textarea>
                    </div>

                    <!-- Select users -->
                    <div class="form-group">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="mb-0"><strong>Recipients</strong>
                                <span class="text-muted small ml-1">(<span id="selected-count">0</span> selected)</span>
                            </label>
                            <div>
                                <button type="button" class="btn btn-xs btn-outline-secondary mr-1" id="select-all">Select All</button>
                                <button type="button" class="btn btn-xs btn-outline-secondary" id="deselect-all">Deselect All</button>
                            </div>
                        </div>

                        <div class="border rounded" style="max-height:360px;overflow-y:auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="thead-light sticky-top">
                                    <tr>
                                        <th style="width:40px;"></th>
                                        <th>Name</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr class="user-row" onclick="toggleRow(this)" style="cursor:pointer;">
                                            <td>
                                                <input type="checkbox" name="userIds" value="@user.Id"
                                                       class="user-checkbox" onclick="event.stopPropagation();"
                                                       onchange="updateCount()" />
                                            </td>
                                            <td>@(user.FullName ?? "—")</td>
                                            <td>@user.Email</td>
                                        </tr>
                                    }
                                    @if (!Model.Any())
                                    {
                                        <tr><td colspan="3" class="text-center text-muted py-3">No users found.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary" id="send-btn" disabled>
                        <i class="fas fa-paper-plane mr-1"></i> Send Message
                    </button>
                    <span class="text-muted ml-3 small">Message will appear in each user's chat with Support.</span>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateCount() {
        const checked = document.querySelectorAll('.user-checkbox:checked').length;
        document.getElementById('selected-count').textContent = checked;
        document.getElementById('send-btn').disabled = checked === 0;
    }

    function toggleRow(row) {
        const cb = row.querySelector('.user-checkbox');
        cb.checked = !cb.checked;
        updateCount();
    }

    document.getElementById('select-all').addEventListener('click', function () {
        document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = true);
        updateCount();
    });

    document.getElementById('deselect-all').addEventListener('click', function () {
        document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = false);
        updateCount();
    });
</script>
}
