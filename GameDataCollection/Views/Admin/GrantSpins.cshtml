@model GameDataCollection.ViewModels.GrantSpinsViewModel
@{
    ViewData["Title"] = "Grant Spins";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-info">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-gift mr-2"></i>Grant Bonus Spins to User</h3>
            </div>
            <form asp-action="GrantSpins" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle mr-1"></i>
                        Granted spins are used when the user has reached their regular spin limit.
                        They are consumed one at a time before the cooldown resets.
                    </div>

                    <div class="form-group">
                        <label asp-for="UserId">User</label>
                        <select asp-for="UserId" class="form-control">
                            <option value="">-- Select User --</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.Id">@user.FullName (@user.Email)</option>
                            }
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="SpinsToGrant"></label>
                        <input asp-for="SpinsToGrant" class="form-control" type="number" min="1" max="100" />
                        <span asp-validation-for="SpinsToGrant" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Note"></label>
                        <input asp-for="Note" class="form-control" placeholder="Optional reason..." />
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-info">
                        <i class="fas fa-paper-plane mr-1"></i> Grant Spins
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
